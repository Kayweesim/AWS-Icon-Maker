# Live collaboration (optional). Without this the app runs offline, single-player.
# Create a project at https://liveblocks.io and copy its *public* key (pk_...).
# Locally: copy this file to .env.local. On Vercel: Project → Settings → Environment Variables.
VITE_LIVEBLOCKS_PUBLIC_KEY=

# Override the AWS Architecture Icons package if AWS retires the built-in URL.
# AWS_ICONS_URL=https://.../Icon-package_....zip
